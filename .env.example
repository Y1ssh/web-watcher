# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# The config file never holds a secret. It only names the variable, like
# "url_env": "WATCHER_WEBHOOK_URL", and the value is read from here at run time.
#
# A value already set in your real environment always wins over this file, so a
# deployment's platform settings are never overwritten by a stray local copy.

# Slack / Discord / Teams incoming webhook. Treat this URL as a password:
# anyone holding it can post to your channel.
# WATCHER_WEBHOOK_URL=https://hooks.slack.com/services/...

# SMTP credentials for the "email" notify channel.
# WATCHER_SMTP_USER=watcher@example.com
# WATCHER_SMTP_PASSWORD=

# Any ${NAME} placeholder used in an action's headers is resolved from here.
# WATCHER_ACTION_TOKEN=
